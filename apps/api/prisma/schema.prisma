// Database schema. Run `npx prisma migrate dev` after changing it.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// CLIENT opens tickets, AGENT answers them, ADMIN manages users and settings.
enum Role {
  CLIENT
  AGENT
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
